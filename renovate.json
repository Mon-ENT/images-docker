{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["modules.json"],
            "matchStrings": [
                "\\{[^}]*\"group\":\\s*\"(?<packageName>[^\"]+)\"[^}]*\"name\":\\s*\"(?<depName>[^\"]+)\"[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\"[^}]*\\}"
            ],
            "datasourceTemplate": "maven",
            "packageNameTemplate": "{{packageName}}:{{depName}}",
            "registryUrlTemplate": "https://maven.opendigitaleducation.com/repository/public"
        }
    ],
    "packageRules": [
        {
            "matchFileNames": ["modules.json"],
            "automerge": true,
            "automergeType": "pr"
        }
    ]
}