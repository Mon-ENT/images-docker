{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["modules.json"],
            "matchStringsStrategy": "combination",
            "matchStrings": [
                "\"group\": \"(?<packageName>[^\"]+)\"",
                "\"name\": \"(?<depName>[^\"]+)\"",
                "\"version\": \"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "maven",
            "packageNameTemplate": "{{packageName}}:{{depName}}",
            "registryUrlTemplate": "https://maven.opendigitaleducation.com/repository/public"
        }
    ],
    "packageRules": [
        {
            "matchFileNames": ["modules.json"],
            "automerge": true,
            "automergeType": "branch",
            "ignoreTests": true
        }
    ]
}